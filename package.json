{
  "name": "prograde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, multi-language programming practice platform with compile-and-run grading.",
  "bin": { "prograde": "bin/prograde.ts" },
  "workspaces": ["web"],
  "scripts": {
    "prograde": "bun bin/prograde.ts",
    "web": "bun bin/prograde.ts web",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit && bun run typecheck:web",
    "typecheck:web": "cd web && bunx svelte-kit sync && bunx tsc --noEmit -p .",
    "selftest": "bun bin/prograde.ts selftest"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
